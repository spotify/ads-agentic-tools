{
  "description": "Auto-refresh expired Spotify OAuth tokens before API calls (GitHub Copilot CLI)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${COPILOT_PLUGIN_ROOT}/hooks/check-token.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
